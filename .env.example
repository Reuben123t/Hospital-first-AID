# Copy these values into the environment before launching Accredix.
# Never commit real credentials.
ACCREDITX_SECRET_KEY=replace-with-a-long-random-secret
ACCREDITX_LOGIN_EMAIL=demo@accreditx.local
ACCREDITX_LOGIN_PASSWORD=change-this-local-password
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Add this exact redirect URI in Google Cloud Console:
# http://127.0.0.1:5000/auth/callback
